# Database configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=consultation123
POSTGRES_DB=consultation_db

# Backend configurations (Use localhost for local uvicorn development; Docker Compose environment overrides these in containers)
DATABASE_URL=postgresql://postgres:consultation123@localhost:5432/consultation_db
SECRET_KEY=change-this-to-a-very-strong-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
REDIS_URL=redis://localhost:6379/0

# Super Admin initial configuration
SUPER_ADMIN_EMAIL=superadmin@platform.com
SUPER_ADMIN_PASSWORD=your-super-admin-secure-password
SUPER_ADMIN_FULL_NAME="Super Administrator"

# Rate limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Embeddings & Generative API Configuration
COHERE_API_KEY=your-cohere-api-key
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-specdec

# Daily.co Video Integration Settings
DAILY_API_KEY=

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@platform.com

# Password Reset URLs
FRONTEND_CLIENT_RESET_URL=http://localhost:3000/reset-password
FRONTEND_CONSULTANT_RESET_URL=http://localhost:3001/reset-password

# Google API OAuth2 Configuration (for Consultant Google Calendar Sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/consultants/auth/google/callback
