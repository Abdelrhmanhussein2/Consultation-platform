DATABASE_URL=postgresql://postgres:postgres@localhost:5432/consultation_db
SECRET_KEY=change-this-to-a-very-strong-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
REDIS_URL=redis://localhost:6379/0

# Super Admin initial configuration
SUPER_ADMIN_EMAIL=superadmin@platform.com
SUPER_ADMIN_PASSWORD=your-super-admin-secure-password
SUPER_ADMIN_FULL_NAME="Super Administrator"

# Rate limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-secure-password
